---
// Editorial page: fully static, rendered at build time.
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedGameCard from '../components/RelatedGameCard.astro';
import { RELATED_GAMES } from '../data/games';
---

<BaseLayout>
  <header class="page-head container--wide">
    <span class="eyebrow">Play Online · In-Site Portal</span>
    <h1>Top Games Like Parking Fury to Play Instantly</h1>
    <p>
      Love the precision and thrills of Parking Fury? The curated games below are all fully playable
      <strong>right here inside our portal</strong> — no downloads, no third-party redirects, and no
      intrusive interruptions. Choose any title to load into our clean, high-performance in-site player.
    </p>
    <div class="chip-row">
      <span class="pill pill--live">100% Free to Play</span>
      <span class="pill">Instant In-Site Player</span>
      <span class="pill">Mobile &amp; Desktop Controls</span>
    </div>
  </header>

  <section class="section section--tight container--wide">
    <div class="section-head">
      <span class="eyebrow">Full Collection</span>
      <h2>All Picks Playable On This Site</h2>
      <p class="muted">Click any game card to launch immediately in your browser.</p>
    </div>
    <div class="game-grid">
      {RELATED_GAMES.map((game) => <RelatedGameCard game={game} />)}
    </div>
  </section>

  <section class="section container prose">
    <h2>How to choose your next game</h2>
    <p>
      Pick by the style of gameplay you enjoy most — precision parking, open 3D city missions, or pure logic:
    </p>
    <ul>
      <li>
        <strong>For story missions &amp; police evasion:</strong>
        <a href="/games/parking-fury-3d-beach-city/">Parking Fury 3D: Beach City</a> and
        <a href="/games/parking-fury-3d-bounty-hunter/">Parking Fury 3D: Bounty Hunter</a>
        add open-world driving, car stealing, and escaping pursuit across bustling 3D avenues.
      </li>
      <li>
        <strong>For dark night-driving thrills:</strong>
        <a href="/games/parking-fury-3/">Parking Fury 3</a> and
        <a href="/games/parking-fury-3d-night-thief/">Parking Fury 3D: Night Thief</a>
        turn off the streetlights and challenge you to navigate tight bays using only your headlights.
      </li>
      <li>
        <strong>For extreme skill &amp; razor-thin clearances:</strong>
        <a href="/games/extreme-car-parking/">Extreme Car Parking</a>
        tests your reflexes against barriers where a single millimeter mistake forces a restart.
      </li>
      <li>
        <strong>For realistic road lessons &amp; mobile play:</strong>
        <a href="/games/car-parking-school/">Car Parking School</a>
        teaches parallel parking and official road maneuvers with phone and tablet support.
      </li>
      <li>
        <strong>For quick arcade drifting:</strong>
        <a href="/games/drive-and-park/">Drive and Park</a>
        delivers addictive one-tap drift-to-curb mechanics.
      </li>
      <li>
        <strong>For calm puzzle solving:</strong>
        <a href="/games/park-out/">Park Out &amp; Master</a>
        is a sliding-block puzzle — slide vehicles along grid tracks to open the golden escape route.
      </li>
    </ul>

    <h2>Quick Game Comparison</h2>
    <div class="table-wrap">
      <table class="data">
        <caption>All featured parking titles — playing right on this site</caption>
        <thead>
          <tr>
            <th scope="col">Game</th>
            <th scope="col">The Difference</th>
            <th scope="col">Supported Devices</th>
            <th scope="col">Play</th>
          </tr>
        </thead>
        <tbody>
          {RELATED_GAMES.map((g) => (
            <tr>
              <th scope="row">
                <a href={g.url} class="table-game-link">
                  <strong>{g.name}</strong>
                </a>
              </th>
              <td>{g.diff}</td>
              <td>{g.devices ?? 'Desktop & Mobile'}</td>
              <td>
                <a href={g.url} class="btn btn--secondary btn--xs">Play Now</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="note">
      <span aria-hidden="true">★</span>
      <span>
        <strong>Play anywhere, anytime:</strong> Every game listed runs directly inside this site via our
        embedded game engine. You never get bounced to external domains or spam portals.
      </span>
    </div>
  </section>
</BaseLayout>
