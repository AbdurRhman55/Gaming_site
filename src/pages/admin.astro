---
/**
 * Admin dashboard — single operator account (ADMIN_USER / ADMIN_PASSWORD),
 * HMAC-signed session cookie, full games CRUD + cover upload. Everything
 * published here appears on /games/ immediately (SSR pages read the same
 * JSON store on each request). Always noindex.
 *
 * The shell (topbar + sidebar) is shared via AdminLayout with the analytics
 * and SEO pages. The games table is server-rendered for a usable no-JS
 * baseline; the client script then takes over so search, status filters,
 * publish toggles, edits and deletes apply instantly without a reload.
 *
 * Both branches render their own BaseLayout (AdminLogin / AdminLayout), so
 * this page must not wrap them in a second one.
 */
import AdminLayout from '../components/admin/AdminLayout.astro';
import AdminLogin from '../components/admin/AdminLogin.astro';
import AdminGames from '../components/admin/AdminGames.astro';
import { isAuthed } from '../lib/auth';
import { listGames } from '../lib/store';
import { summarize } from '../lib/analytics';

const authed = isAuthed(Astro.cookies);
const games = authed ? listGames() : [];
const counts = {
  total: games.length,
  published: games.filter((g) => g.status === 'published').length,
  drafts: games.filter((g) => g.status === 'draft').length,
  featured: games.filter((g) => g.featured).length,
};

// First-party analytics for the overview tiles — real recorded counts only.
const allTime = authed ? summarize({ period: 'year' }) : null;
const weekAgo = new Date(Date.now() - 6 * 864e5).toISOString().slice(0, 10);
const week = authed ? summarize({ period: 'day', since: weekAgo }) : null;
const topPage = allTime?.topPages[0] ?? null;
const topGame = allTime?.topGames[0] ?? null;
const publishedGames = games.filter((g) => g.status === 'published');
---

{!authed ? (
  <AdminLogin />
) : (
  <AdminLayout title="Dashboard" crumb="Library & publishing" active="overview">
    <div class="admin-stats" data-admin-stats>
      <div class="admin-stat">
        <span class="admin-stat__label">Views · all time</span>
        <strong data-stat="views-total">{allTime?.totals.views ?? 0}</strong>
        <span class="admin-stat__sub small muted">{week?.totals.views ?? 0} in last 7 days</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat__label">Game plays · all time</span>
        <strong data-stat="plays-total">{allTime?.totals.plays ?? 0}</strong>
        <span class="admin-stat__sub small muted">{week?.totals.plays ?? 0} in last 7 days</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat__label">Top page</span>
        <strong class="admin-stat__text" data-stat="top-page">{topPage?.path ?? '—'}</strong>
        <span class="admin-stat__sub small muted">{topPage ? `${topPage.views} views` : 'no traffic yet'}</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat__label">Most played</span>
        <strong class="admin-stat__text" data-stat="top-game">
          {topGame ? publishedGames.find((g) => g.slug === topGame.slug)?.title ?? topGame.slug : '—'}
        </strong>
        <span class="admin-stat__sub small muted">{topGame ? `${topGame.plays} plays` : 'no plays yet'}</span>
      </div>
    </div>

    <AdminGames games={games} counts={counts} />

    <p class="small muted admin-note">
      First-party counts only — a same-origin beacon reports page loads and game-frame opens, and this
      server records them itself: no cookies, no third-party trackers, no estimates. Use them to
      cross-check <a href="https://search.google.com/search-console" target="_blank" rel="noopener noreferrer">Search&nbsp;Console</a>
      and AdSense. Full breakdowns live in <a href="/admin/analytics/">Analytics</a>.
    </p>
  </AdminLayout>
)}
