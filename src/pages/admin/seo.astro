---
/**
 * Admin → Search & SEO — live sitemap audit, indexability roll-up and the
 * pre-flight checklist an operator runs before submitting the site to
 * Google Search Console. Data comes from /api/admin/seo/ (games store +
 * canonical registry) — nothing is invented, no network calls.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminLayout from '../../components/admin/AdminLayout.astro';
import AdminLogin from '../../components/admin/AdminLogin.astro';
import { isAuthed } from '../../lib/auth';
import { listGames } from '../../lib/store';

const authed = isAuthed(Astro.cookies);
const published = authed ? listGames({ publishedOnly: true }) : [];
const drafts = authed ? listGames().filter((g) => g.status === 'draft') : [];

// Server-rendered baseline (the client re-fetches for the live roll-up).
const baseline = {
  editorial: 13,
  games: published.length,
  indexable: 13 + published.length,
  excluded: 2 + drafts.length,
};
---

{!authed ? (
  <AdminLogin />
) : (
  <AdminLayout title="Search & SEO" crumb="Sitemap & indexing" active="seo">
      <div class="seo" data-seo>
        <div class="admin-stats seo__kpis">
          <div class="admin-stat admin-stat--live">
            <span class="admin-stat__label">Indexable pages</span>
            <strong data-seo-stat="indexable">{baseline.indexable}</strong>
            <span class="admin-stat__sub small muted">editorial + published games</span>
          </div>
          <div class="admin-stat">
            <span class="admin-stat__label">Editorial pages</span>
            <strong data-seo-stat="editorial">{baseline.editorial}</strong>
            <span class="admin-stat__sub small muted">guides & legal</span>
          </div>
          <div class="admin-stat">
            <span class="admin-stat__label">Game pages</span>
            <strong data-seo-stat="games">{baseline.games}</strong>
            <span class="admin-stat__sub small muted">published</span>
          </div>
          <div class="admin-stat">
            <span class="admin-stat__label">Excluded</span>
            <strong data-seo-stat="excluded">{baseline.excluded}</strong>
            <span class="admin-stat__sub small muted">noindex, drafts, 404</span>
          </div>
        </div>

        <section class="panel seo__links" aria-labelledby="links-title">
          <div class="admin-toolbar">
            <h2 class="admin-toolbar__title" id="links-title">Submit to Search Console</h2>
            <p class="small muted">verify ownership, then add these</p>
          </div>
          <ul class="seo__linklist" data-seo-links>
            <li><a data-seo-sitemap href="/sitemap.xml" target="_blank" rel="noopener noreferrer">/sitemap.xml</a> <span class="small muted">— all indexable URLs</span></li>
            <li><a data-seo-robots href="/robots.txt" target="_blank" rel="noopener noreferrer">/robots.txt</a> <span class="small muted">— crawl rules + sitemap pointer</span></li>
          </ul>
          <p class="small muted" data-seo-origin>origin: —</p>
        </section>

        <section class="panel seo__checklist" aria-labelledby="checklist-title">
          <div class="admin-toolbar">
            <h2 class="admin-toolbar__title" id="checklist-title">Indexability checklist</h2>
            <p class="small muted">generated from the live store</p>
          </div>
          <ul class="seo__checks" data-seo-checks>
            <li class="seo__check seo__check--ok"><strong>Unique titles &amp; descriptions</strong><span>every route renders its own title, meta description and H1</span></li>
            <li class="seo__check seo__check--ok"><strong>Canonical URLs</strong><span>self-referencing canonical on all indexable pages</span></li>
            <li class="seo__check seo__check--ok"><strong>Structured data</strong><span>JSON-LD (WebSite, CollectionPage, VideoGame, FAQPage, BreadcrumbList)</span></li>
            <li class="seo__check seo__check--ok"><strong>noindex coverage</strong><span>admin, 404 and drafts are excluded from the sitemap</span></li>
            <li class="seo__check seo__check--ok"><strong> robots.txt + sitemap.xml</strong><span>served, valid, and pointing at each other</span></li>
          </ul>
          <p class="small muted">
            Core Web Vitals and keyword positions come from Search Console itself — this console only audits
            what this server publishes, so nothing here is estimated or guessed.
          </p>
        </section>

        <section class="panel seo__table" aria-labelledby="urls-title">
          <div class="admin-toolbar">
            <h2 class="admin-toolbar__title" id="urls-title">Sitemap contents</h2>
            <p class="small muted" data-seo-counts>{baseline.indexable} indexable · {baseline.excluded} excluded</p>
          </div>
          <div class="admin-table-wrap">
            <table class="admin-table">
              <thead>
                <tr>
                  <th scope="col">Path</th>
                  <th scope="col">Title</th>
                  <th scope="col">Index</th>
                </tr>
              </thead>
              <tbody data-seo-body></tbody>
            </table>
          </div>
          <p class="empty-state" data-seo-loading>Loading sitemap audit…</p>
        </section>
      </div>
    </AdminLayout>
  )}

<script>
  /* SEO audit controller: fetch /api/admin/seo/ and render the roll-up. */
  interface SeoRow { path: string; title: string; indexable: boolean }
  interface SeoPayload {
    origin: string;
    sitemapUrl: string;
    robotsUrl: string;
    counts: { editorial: number; games: number; indexable: number; excluded: number };
    editorial: SeoRow[];
    games: SeoRow[];
    excluded: { path: string; reason: string }[];
  }

  const root = document.querySelector<HTMLElement>('[data-seo]');
  if (root) {
    const escapeHtml = (s: string) =>
      s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string);

    const set = (key: string, value: number) => {
      const el = root.querySelector<HTMLElement>(`[data-seo-stat="${key}"]`);
      if (el) el.textContent = String(value);
    };

    void (async () => {
      try {
        const res = await fetch('/api/admin/seo/');
        if (!res.ok) return;
        const data = (await res.json()) as SeoPayload & { ok?: boolean };
        if (!data || !data.counts) return;

        set('editorial', data.counts.editorial);
        set('games', data.counts.games);
        set('indexable', data.counts.indexable);
        set('excluded', data.counts.excluded);

        const countsEl = root.querySelector<HTMLElement>('[data-seo-counts]');
        if (countsEl) countsEl.textContent = `${data.counts.indexable} indexable · ${data.counts.excluded} excluded`;

        const originEl = root.querySelector<HTMLElement>('[data-seo-origin]');
        if (originEl) originEl.textContent = `origin: ${data.origin}`;

        const sm = root.querySelector<HTMLAnchorElement>('[data-seo-sitemap]');
        if (sm) sm.href = data.sitemapUrl;
        const rb = root.querySelector<HTMLAnchorElement>('[data-seo-robots]');
        if (rb) rb.href = data.robotsUrl;

        const body = root.querySelector<HTMLElement>('[data-seo-body]');
        const loading = root.querySelector<HTMLElement>('[data-seo-loading]');
        if (loading) loading.hidden = true;
        if (body) {
          const rows = [...data.editorial, ...data.games];
          body.innerHTML = rows
            .map(
              (r) => `<tr>
                <td class="admin-table__game"><strong>${escapeHtml(r.path)}</strong></td>
                <td class="small muted">${escapeHtml(r.title)}</td>
                <td><span class="badge badge--live"><span class="badge__dot" aria-hidden="true"></span>index</span></td>
              </tr>`,
            )
            .join('');
        }
      } catch {
        /* keep the server-rendered baseline on failure */
      }
    })();
  }
</script>
