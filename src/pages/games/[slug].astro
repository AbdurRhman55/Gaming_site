---
/**
 * Game player page — the game plays inside this site in a full-width frame.
 * Server-rendered per request: publishing, editing or deleting a game in the
 * dashboard is reflected immediately.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameCard from '../../components/GameCard.astro';
import { getGameBySlug, listGames } from '../../lib/store';
import { canonicalUrl } from '../../data/seo';

const slug = Astro.params.slug ?? '';
const game = getGameBySlug(slug, { publishedOnly: true });
if (!game) {
  // Missing or unpublished slug: serve the prerendered 404 document with a
  // real 404 status. (Astro.rewrite('/404') cannot target a prerendered route
  // in server mode — it throws — so we fetch the built /404.html directly.)
  try {
    const notFound = await fetch(new URL('/404.html', Astro.url.origin));
    if (notFound.ok) {
      return new Response(await notFound.text(), {
        status: 404,
        headers: { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-store' },
      });
    }
  } catch {
    /* fall through to the minimal body below */
  }
  return new Response('<!doctype html><title>Page Not Found</title><h1>Page Not Found</h1>', {
    status: 404,
    headers: { 'Content-Type': 'text/html; charset=utf-8' },
  });
}

const description =
  game.description.length > 158 ? game.description.slice(0, 155).trimEnd() + '…' : game.description;

const published = listGames({ publishedOnly: true }).filter((g) => g.slug !== game.slug);
const sameCategory = published.filter((g) => g.category.toLowerCase() === game.category.toLowerCase());
const otherCategories = published.filter((g) => g.category.toLowerCase() !== game.category.toLowerCase());
const related = [...sameCategory, ...otherCategories].slice(0, 4);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: game.title,
    description: game.description,
    url: canonicalUrl(Astro.site ?? 'http://localhost:4321', `/games/${game.slug}/`),
    applicationCategory: 'Game',
    operatingSystem: 'Any (plays in a web browser)',
    gamePlatform: 'Web browser',
    genre: game.category,
    author: { '@type': 'Organization', name: 'Parking Fury Guide' },
  },
];
---

<BaseLayout
  seo={{
    title: game.title.toLowerCase().includes('parking')
      ? `${game.title}: Play Free Online`
      : `${game.title}: Play Free Online Parking Game`,
    description,
    path: `/games/${game.slug}/`,
  }}
  trail={[{ name: 'Games', path: '/games/' }, { name: game.title, path: `/games/${game.slug}/` }]}
  jsonLd={jsonLd}
>
  <section class="player player--backdrop" data-player aria-label={`${game.title} game player`}>
    <div class="player__frame" data-player-frame>
      <iframe
        class="player__iframe"
        src={game.embedUrl}
        data-slug={game.slug}
        title={`${game.title} — playing inside this site`}
        allow="fullscreen; autoplay; gamepad; encrypted-media; picture-in-picture"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>
    <div class="player__bar container--wide">
      <a class="btn btn--ghost btn--sm" href="/games/"><span aria-hidden="true">←</span> All games</a>
      <span class="small muted player__hint">The game runs in this frame — it never redirects you elsewhere.</span>
      <button class="btn btn--secondary btn--sm" type="button" data-fullscreen>Fullscreen</button>
    </div>
  </section>

  <article class="section container--wide game-detail">
    <header class="game-detail__head">
      <h1 class="game-detail__title">{game.title}</h1>
      <div class="game-detail__chips">
        <span class="chip">{game.category}</span>
        {game.featured && <span class="chip chip--accent">Featured</span>}
        {game.tags.map((tag) => <span class="chip chip--muted">{tag}</span>)}
      </div>
    </header>

    <p class="lead game-detail__desc">{game.description}</p>

    <div class="game-detail__grid">
      {game.controls && (
        <section class="panel">
          <h2>Controls</h2>
          <p>{game.controls}</p>
        </section>
      )}
      {game.specs.length > 0 && (
        <section class="panel">
          <h2>Game info</h2>
          <dl class="spec-table">
            {game.specs.map((spec) => (
              <>
                <dt>{spec.label}</dt>
                <dd>{spec.value}</dd>
              </>
            ))}
          </dl>
        </section>
      )}
    </div>

    {related.length > 0 && (
      <section class="game-detail__related" aria-labelledby="related-heading">
        <h2 id="related-heading">More {game.category} games</h2>
        <div class="game-grid game-grid--compact">
          {related.map((g) => (
            <GameCard
              title={g.title}
              href={`/games/${g.slug}/`}
              description={g.description}
              cover={g.cover}
              category={g.category}
            />
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<script>
  const btn = document.querySelector('[data-fullscreen]');
  const frame = document.querySelector('[data-player-frame]');
  btn?.addEventListener('click', () => {
    if (!frame) return;
    if (document.fullscreenElement) void document.exitFullscreen();
    else void frame.requestFullscreen?.();
  });

  // First-party play beacon: the game frame finished loading its document —
  // the most honest "the game opened" signal that works identically for
  // internal (/embed/…) and external embeds. Counted once per page load.
  const gameFrame = document.querySelector<HTMLIFrameElement>('iframe.player__iframe[data-slug]');
  if (gameFrame) {
    const slug = gameFrame.dataset.slug ?? '';
    let counted = false;
    const countPlay = () => {
      if (counted) return;
      counted = true;
      fetch('/api/track/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ kind: 'play', slug }),
        keepalive: true,
        credentials: 'omit',
      }).catch(() => {});
    };
    gameFrame.addEventListener('load', countPlay);
    // Fast same-origin embeds can finish before this deferred script attaches
    // its listener — detect that case for internal frames.
    try {
      const doc = gameFrame.contentDocument; // null for cross-origin frames
      if (doc && doc.readyState === 'complete') countPlay();
    } catch {
      /* cross-origin — the load listener above covers it */
    }
  }
</script>
