---

// Editorial page: fully static, rendered at build time.
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import GameStage from '../components/GameStage.astro';
import RelatedGameCard from '../components/RelatedGameCard.astro';
import { VERSIONS, RELATED_GAMES, OFFICIAL_HOSTS } from '../data/games';

const game = VERSIONS.find((v) => v.slug === 'parking-fury-3d')!;
const seriesGames = RELATED_GAMES.filter((g) => g.name.startsWith('Parking Fury 3D:'));

const videoGameSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: 'Parking Fury 3D',
  description:
    '3D driving and parking game by Brain Software, released on Poki in March 2019: sneak past police cars, park and deliver vehicles through dark city streets.',
  datePublished: '2019-03',
  dateModified: '2022-06',
  gamePlatform: 'Web browser',
  playMode: 'SinglePlayer',
  inLanguage: 'en',
  url: 'https://poki.com/en/g/parking-fury-3d',
};
---

<BaseLayout jsonLd={[videoGameSchema]}>
  <header class="page-head container--wide">
    <span class="eyebrow">A different series · 3D</span>
    <h1>Parking Fury 3D: Controls, Missions and the Full 3D Series</h1>
    <p>
      Parking Fury 3D shares the name and the parking idea with the top-down games — and very
      little else. It is a 3D driving game by <strong>Brain Software</strong>, released on Poki
      in March 2019, where you slip past police cars, find empty spots and deliver vehicles
      without a scratch through dark city streets.
    </p>
    <div class="chip-row">
      <span class="pill">Released March 2019</span>
      <span class="pill">Brain Software</span>
      <span class="pill">Desktop (per Poki)</span>
      <span class="pill">Host: Poki</span>
    </div>
  </header>

  <section class="section--tight container--wide" aria-label="Play Parking Fury 3D">
    <GameStage
      title="Parking Fury 3D"
      officialUrl={game.officialUrl}
      officialHost={game.host}
      embedUrl="https://www.bubbleshooter.net/embed.php?id=1698"
      miniGame={true}
      credit="Play Parking Fury 3D directly in your browser on this site."
    />
  </section>

  <section class="section container prose">
    <h2>What the game is</h2>
    <p>
      Poki’s own description sets the scene: you drive muscle cars through the dark streets of a
      crowded city, steering around other vehicles and pedestrians, parking without damage — and,
      when the mission calls for it, taking a car you are not meant to have and hiding it. Missions
      pay out only if the car arrives unscratched.
    </p>
    <p>
      It is listed under driving games by developer Brain Software, released March 2019 and last
      updated June 2022. Poki’s supported-devices field reads <strong>Desktop</strong> for this
      title, unlike several other parking games on the platform that list phones and tablets — so
      assume keyboard-and-mouse unless you have verified otherwise on your own device.
    </p>

    <div class="note note--warn">
      <span aria-hidden="true">⚠</span>
      <span>
        <strong>Do not confuse the two series.</strong> Parking Fury 1–3 are top-down games by
        Andriy Pidvirnyy on Coolmath Games. The 3D games are by Brain Software and live on Poki —
        different controls, different physics, different missions. See the
        <a href="/">original series guide</a> if you wanted the top-down games.
      </span>
    </div>

    <h2>Parking Fury 3D controls</h2>
    <div class="table-wrap">
      <table class="data">
        <caption>Controls as published by Poki, checked October 2026</caption>
        <thead>
          <tr>
            <th scope="col">Game</th>
            <th scope="col">Drive</th>
            <th scope="col">Special keys</th>
            <th scope="col">Devices</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Parking Fury 3D</th>
            <td>Arrow keys</td>
            <td><kbd class="kbd">Ctrl</kbd> to enter or exit vehicles</td>
            <td>Desktop</td>
          </tr>
          <tr>
            <th scope="row">3D: Bounty Hunter</th>
            <td><kbd class="kbd">W</kbd><kbd class="kbd">A</kbd><kbd class="kbd">S</kbd><kbd class="kbd">D</kbd> or arrows</td>
            <td><kbd class="kbd">Ctrl</kbd> steal · <kbd class="kbd">Space</kbd> handbrake · <kbd class="kbd">C</kbd> camera</td>
            <td>Desktop</td>
          </tr>
          <tr>
            <th scope="row">3D: Beach City</th>
            <td>Arrow keys</td>
            <td><kbd class="kbd">Ctrl</kbd> enter car · <kbd class="kbd">C</kbd> camera</td>
            <td>Desktop</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p>
      The third-person camera (<kbd class="kbd">C</kbd>) matters more than it sounds: parking
      bays sit at angles the default view flattens. Flip views before you commit to a reverse
      manoeuvre rather than mid-way through it. For parking technique that transfers across
      camera angles, see the <a href="/walkthrough/">walkthrough method</a> and
      <a href="/tips/">tips</a>.
    </p>

    <h2>How it differs from the top-down Parking Fury games</h2>
    <div class="table-wrap">
      <table class="data">
        <caption>Two series, one name — facts from each game’s official host</caption>
        <thead>
          <tr>
            <th scope="col">&nbsp;</th>
            <th scope="col">Parking Fury 1–3</th>
            <th scope="col">Parking Fury 3D series</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Developer</th>
            <td>Andriy Pidvirnyy</td>
            <td>Brain Software</td>
          </tr>
          <tr>
            <th scope="row">View</th>
            <td>Top-down, 2D lots</td>
            <td>Full 3D city streets</td>
          </tr>
          <tr>
            <th scope="row">Hosted on</th>
            <td>Coolmath Games</td>
            <td>Poki</td>
          </tr>
          <tr>
            <th scope="row">Release</th>
            <td>2016–2017</td>
            <td>March 2019 (Beach City: November 2019)</td>
          </tr>
          <tr>
            <th scope="row">Core loop</th>
            <td>Park one car, next layout, no crashes</td>
            <td>Steal, drive and deliver cars; dodge police</td>
          </tr>
          <tr>
            <th scope="row">Devices</th>
            <td>Browser + mobile</td>
            <td>Desktop (per Poki)</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2>The rest of the 3D series</h2>
    <div class="grid">
      {seriesGames.map((g) => <RelatedGameCard game={g} />)}
    </div>

    <div class="btn-row" style="margin:1.5rem 0">
      <a class="btn btn--primary" href={game.officialUrl} target="_blank" rel="noopener noreferrer">
        Play Parking Fury 3D on Poki<span class="sr-only">(opens in a new tab)</span>
      </a>
      <a class="btn btn--secondary" href={OFFICIAL_HOSTS.pokiParking} target="_blank" rel="noopener noreferrer">More parking games on Poki<span class="sr-only">(opens in a new tab)</span></a>
    </div>

    <h2>More from this site</h2>
    <ul class="link-list">
      <li>
        <a class="link-card" href="/">
          <span class="link-card__icon" aria-hidden="true">1</span>
          <span><strong>Parking Fury (the original)</strong><span>Top-down classic, controls, walkthrough and our playable mini-game.</span></span>
        </a>
      </li>
      <li>
        <a class="link-card" href="/similar-games/">
          <span class="link-card__icon" aria-hidden="true">10</span>
          <span><strong>Games like Parking Fury</strong><span>Ten alternatives with controls and device support listed up front.</span></span>
        </a>
      </li>
    </ul>
  </section>

  <section class="section container--wide">
    <div class="section-head">
      <span class="eyebrow">FAQ</span>
      <h2>Parking Fury 3D questions</h2>
    </div>
    <div class="faq">
      <details>
        <summary>Is Parking Fury 3D the same as Parking Fury?</summary>
        <div class="faq__answer">
          No — different developer, view and gameplay. The top-down trilogy is by Andriy Pidvirnyy
          on Coolmath Games; the 3D series is by Brain Software on Poki. The comparison table
          above lays it out.
        </div>
      </details>
      <details>
        <summary>Does Parking Fury 3D work on phones?</summary>
        <div class="faq__answer">
          Poki’s supported-devices field for this game says Desktop only, and its controls assume
          a keyboard (arrow keys plus Ctrl). Other parking games on Poki do list phone and tablet
          support — see <a href="/similar-games/">similar games</a> for those.
        </div>
      </details>
      <details>
        <summary>How do you get in and out of cars?</summary>
        <div class="faq__answer">
          <kbd class="kbd">Ctrl</kbd> enters or exits vehicles in Parking Fury 3D. Bounty Hunter
          adds <kbd class="kbd">Space</kbd> for the handbrake, and both sequels let you switch
          camera with <kbd class="kbd">C</kbd>.
        </div>
      </details>
    </div>
  </section>
</BaseLayout>
