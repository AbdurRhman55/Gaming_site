---
/**
 * TightLotPlayer — the original parking mini-game as a standalone,
 * full-viewport document. Designed to be embedded in the site's own
 * /games/[slug]/ iframe player (internal embed) or opened directly.
 * Reuses the exact HUD/canvas/touch markup the GameStage uses.
 */
import '../styles/global.css';
---

<div class="minigame minigame--solo" data-minigame>
  <div class="hud" role="status" aria-live="polite">
    <div class="hud__group">
      <span class="hud__brand" aria-hidden="true">
        <img src="/images/logo-mark.png" alt="" width="20" height="20" />
      </span>
      <span>Lot <strong data-hud-level>1/3</strong></span>
      <span>Time <strong data-hud-time>0.0s</strong></span>
      <span>Scrapes <strong data-hud-scrapes>0</strong></span>
    </div>
    <div class="hud__group">
      <span data-hud-status>Ready</span>
    </div>
  </div>
  <div class="minigame__canvas-wrap" data-canvas-wrap>
    <canvas data-canvas width="640" height="400">
      An original top-down parking mini-game: steer a car into the
      highlighted bay without touching walls or parked cars.
    </canvas>
    <div class="stage__panel" data-panel="gameover" hidden>
      <h3 data-over-title>Level complete</h3>
      <p data-over-text></p>
      <div class="btn-row">
        <button class="btn btn--primary" type="button" data-action="next">Next lot</button>
        <button class="btn btn--secondary" type="button" data-action="restart">Restart</button>
      </div>
    </div>
  </div>
  <div class="touch-pad" aria-label="Touch driving controls">
    <div class="touch-pad__cluster">
      <button class="touch-btn" type="button" data-key="left" aria-label="Steer left">◀<small>Left</small></button>
      <button class="touch-btn" type="button" data-key="right" aria-label="Steer right">▶<small>Right</small></button>
    </div>
    <div class="touch-pad__cluster">
      <button class="touch-btn" type="button" data-key="down" aria-label="Reverse or brake">▼<small>Reverse</small></button>
      <button class="touch-btn" type="button" data-key="up" aria-label="Accelerate">▲<small>Gas</small></button>
    </div>
  </div>
</div>

<script>
  import { initParkingGame } from '../scripts/parking-game';
  const root = document.querySelector('[data-minigame]');
  if (root instanceof HTMLElement) {
    initParkingGame(root);
    // Panel buttons announce themselves as minigame commands — the same event
    // the engine listens for (mirrors GameStage's dispatcher).
    document.querySelectorAll<HTMLElement>('[data-action]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.dispatchEvent(
          new CustomEvent('minigame:command', { detail: { action: btn.dataset.action } }),
        );
      });
    });
  }
</script>

<style is:global>
  html,
  body {
    height: 100%;
  }
  body {
    margin: 0;
    background: #111318;
    color: #f7f6f2;
    display: flex;
    align-items: stretch;
    justify-content: center;
    overflow-x: hidden;
  }
  .minigame--solo {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(8px, 1.6vmin, 14px);
    width: 100%;
    min-height: 100dvh;
    box-sizing: border-box;
    padding: clamp(8px, 2vmin, 18px);
  }
  .minigame--solo .minigame__canvas-wrap {
    position: relative;
    width: 100%;
  }
  .minigame--solo canvas {
    display: block;
    width: 100%;
    height: auto;
    background: #1a1d24;
    border-radius: 14px;
  }
</style>
