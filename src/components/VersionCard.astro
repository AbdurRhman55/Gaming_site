---
import GameArt from './GameArt.astro';
import type { GameVersion } from '../data/games';

interface Props {
  game: GameVersion;
}

const { game } = Astro.props;

// Map each Parking Fury series version to its direct in-site playable page
const playRouteMap: Record<string, string> = {
  'parking-fury': '/games/tight-lot/',
  'parking-fury-2': '/games/traffic-rush/',
  'parking-fury-3': '/games/parking-fury-3/',
  'parking-fury-3d': '/games/parking-fury-3d/',
};
const playPath = playRouteMap[game.slug] ?? `/games/${game.slug}/`;
---

<article class="game-card">
  <div class="game-card__media">
    {game.cover ? (
      <img
        src={game.cover}
        alt={`${game.name} cover`}
        width="640"
        height="360"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="game-card__art">
        <GameArt
          id={game.art}
          alt={`Original illustration for ${game.name}: a stylised ${game.path === '/parking-fury-3d/' ? '3D city street' : 'parking lot'} scene with a car approaching a highlighted bay.`}
        />
      </div>
    )}
    <span class="game-card__play" aria-hidden="true">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z" /></svg>
    </span>
    <span class="game-card__badge game-card__badge--accent">Official Series</span>
  </div>
  <div class="game-card__body">
    <h3 class="game-card__title">
      <a href={playPath}>{game.name}</a>
    </h3>
    <p class="game-card__desc">{game.tagline}</p>
    <div class="card__meta">
      <span class="badge badge--live"><span class="badge__dot" aria-hidden="true"></span>Play in site</span>
      <span class="badge">{game.release}</span>
      <span class="badge">{game.controls}</span>
    </div>
    <div class="btn-row" style="margin-top:0.75rem">
      <a class="btn btn--primary btn--sm" href={playPath}>Play Now</a>
      {game.path && <a class="btn btn--secondary btn--sm" href={game.path}>Series Guide</a>}
    </div>
  </div>
</article>
