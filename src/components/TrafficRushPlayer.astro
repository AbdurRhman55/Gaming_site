---
/**
 * TrafficRushPlayer — the original Traffic Rush endless dodger as a
 * standalone, full-viewport document for the in-site iframe player.
 */
import '../styles/global.css';
---

<div class="traffic traffic--solo" data-traffic>
  <div class="hud" role="status" aria-live="polite">
    <div class="hud__group">
      <span class="hud__brand" aria-hidden="true">
        <img src="/images/logo-mark.png" alt="" width="20" height="20" />
      </span>
      <span>Distance <strong data-tr-score>0 m</strong></span>
      <span>Best <strong data-tr-best>0 m</strong></span>
    </div>
    <div class="hud__group">
      <span data-tr-status>Dodging</span>
    </div>
  </div>
  <div class="traffic__canvas-wrap">
    <canvas data-canvas width="480" height="640">
      An original endless driving game: switch lanes to dodge oncoming traffic
      for as long as you can.
    </canvas>
    <div class="stage__panel" data-panel="gameover" hidden>
      <h3>Crashed</h3>
      <p data-over-text></p>
      <div class="btn-row">
        <button class="btn btn--primary" type="button" data-action="restart">Drive again</button>
      </div>
    </div>
  </div>
  <div class="touch-pad" aria-label="Touch steering controls">
    <div class="touch-pad__cluster">
      <button class="touch-btn" type="button" data-key="left" aria-label="Move one lane left">◀<small>Left</small></button>
      <button class="touch-btn" type="button" data-key="right" aria-label="Move one lane right">▶<small>Right</small></button>
    </div>
  </div>
</div>

<script>
  import { initTrafficRush } from '../scripts/traffic-rush';
  const root = document.querySelector('[data-traffic]');
  if (root instanceof HTMLElement) initTrafficRush(root);
</script>

<style is:global>
  html,
  body {
    height: 100%;
  }
  body {
    margin: 0;
    background: #111318;
    color: #f7f6f2;
    display: flex;
    align-items: stretch;
    justify-content: center;
    overflow-x: hidden;
  }
  .traffic--solo {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(8px, 1.6vmin, 14px);
    width: 100%;
    max-width: 640px;
    min-height: 100dvh;
    box-sizing: border-box;
    padding: clamp(8px, 2vmin, 18px);
  }
  .traffic--solo .traffic__canvas-wrap {
    position: relative;
    width: 100%;
  }
  .traffic--solo canvas {
    display: block;
    width: min(100%, 44dvh);
    height: auto;
    margin-inline: auto;
    background: #0f1220;
    border-radius: 14px;
  }
</style>
