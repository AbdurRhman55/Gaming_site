---
/**
 * VideoHero — full-bleed homepage hero: background gameplay video with the
 * brand logo plate, headline and calls to action. The video is muted,
 * looping and inline (no fullscreen takeover); under
 * prefers-reduced-motion it is hidden in CSS and paused in JS, leaving the
 * poster/gradient background.
 */
interface Props {
  /** href of the primary "play" CTA (featured game or the library). */
  featuredHref: string;
  /** Label of the primary CTA. */
  featuredTitle: string;
}
const { featuredHref, featuredTitle } = Astro.props;
---

<section class="hero">
  <div class="hero__bg" aria-hidden="true">
    <video
      class="hero__video"
      data-hero-video
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/images/hero-poster.jpg"
      tabindex="-1"
    >
      <source src="/bg_video.mp4" type="video/mp4" />
    </video>
    <div class="hero__scrim"></div>
  </div>

  <div class="hero__inner container--wide">
    <h1 class="hero__brand">
      <img
        class="hero__logo"
        src="/images/logo-hero.jpg"
        alt="Parking Fury"
        width="880"
        height="495"
        fetchpriority="high"
      />
      <span class="hero__sub">Free parking &amp; driving games that play right in your browser</span>
    </h1>

    <p class="hero__lede">
      Park it here: play original games inside this site, use the verified Parking Fury controls and
      walkthroughs, and jump into the whole series — no downloads, no redirects to other websites.
    </p>

    <div class="hero__ctas">
      <a class="btn btn--primary btn--lg" href={featuredHref}>Play {featuredTitle}</a>
      <a class="btn btn--secondary btn--lg" href="/games/">Browse all games</a>
      <a class="btn btn--ghost btn--lg" href="/how-to-play/">Controls guide</a>
    </div>

    <ul class="hero__chips">
      <li>Plays in your browser</li>
      <li>Original mini-games on site</li>
      <li>Keyboard &amp; touch</li>
      <li>No sign-up, no ads</li>
    </ul>
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (video) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const applyPreference = () => {
      if (reduce.matches) {
        video.pause();
        video.removeAttribute('autoplay');
      } else {
        void video.play().catch(() => {
          /* autoplay blocked — poster stays visible */
        });
      }
    };
    applyPreference();
    reduce.addEventListener('change', applyPreference);
    // Pause while off-screen to keep the main thread quiet.
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && !reduce.matches) void video.play().catch(() => {});
          else video.pause();
        }
      },
      { threshold: 0.15 },
    );
    io.observe(video);
  }
</script>
