---
/**
 * AdminGames — the library table + add/edit form + stat tiles, with the
 * instant (no-reload) CRUD client script. Extracted verbatim from the
 * original single-file admin page so every e2e selector is preserved:
 *   [data-stat] .admin-table [data-admin-search] [data-admin-filter]
 *   [data-admin-no-match] [data-new-game] [data-edit] [data-toggle]
 *   [data-delete] [data-game-form] [data-save-label] [data-reset]
 *   [data-drop-zone] [data-cover-preview] [data-form-error] [data-upload-error]
 */
import type { Game } from '../../lib/store';

interface Props {
  games: Game[];
  counts: { total: number; published: number; drafts: number; featured: number };
}

const { games, counts } = Astro.props;
const CATEGORIES = ['parking', 'driving', 'racing', 'arcade', 'puzzle'];
const searchIndex = (title: string, slug: string, category: string, tags: string[]) =>
  `${title} ${slug} ${category} ${tags.join(' ')}`.toLowerCase();
---

<div class="admin-stats" data-admin-stats>
  <div class="admin-stat">
    <span class="admin-stat__label">Total games</span>
    <strong data-stat="total">{counts.total}</strong>
  </div>
  <div class="admin-stat admin-stat--live">
    <span class="admin-stat__label">Live now</span>
    <strong data-stat="published">{counts.published}</strong>
  </div>
  <div class="admin-stat">
    <span class="admin-stat__label">Drafts</span>
    <strong data-stat="drafts">{counts.drafts}</strong>
  </div>
  <div class="admin-stat">
    <span class="admin-stat__label">Featured</span>
    <strong data-stat="featured">{counts.featured}</strong>
  </div>
</div>

<div class="admin-grid">
  <div class="admin-games panel">
    <div class="admin-toolbar">
      <h2 class="admin-toolbar__title">Library</h2>
      <div class="admin-toolbar__tools">
        <label class="sr-only" for="admin-search">Search games</label>
        <input
          class="input"
          id="admin-search"
          type="search"
          placeholder="Search title, slug, category…"
          data-admin-search
          autocomplete="off"
        />
        <div class="admin-filters" role="group" aria-label="Filter by status">
          <button class="chip chip--link chip--active" type="button" data-admin-filter="all" aria-pressed="true">All</button>
          <button class="chip chip--link" type="button" data-admin-filter="published" aria-pressed="false">Live</button>
          <button class="chip chip--link" type="button" data-admin-filter="draft" aria-pressed="false">Drafts</button>
        </div>
        <button class="btn btn--primary btn--sm" type="button" data-new-game>
          <span aria-hidden="true">＋</span> New game
        </button>
      </div>
    </div>
    <p class="admin-count small muted" data-admin-count>
      {counts.total} game{counts.total === 1 ? '' : 's'}
    </p>

    {games.length === 0 ? (
      <div class="empty-state" data-admin-empty>
        <h3>No games yet</h3>
        <p>Publish your first game with the form — it goes live on /games/ the moment it is saved.</p>
        <button class="btn btn--primary" type="button" data-new-game>Add your first game</button>
      </div>
    ) : (
      <>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th scope="col">Cover</th>
                <th scope="col">Game</th>
                <th scope="col">Category</th>
                <th scope="col">Status</th>
                <th scope="col">Featured</th>
                <th scope="col">Updated</th>
                <th scope="col">Actions</th>
              </tr>
            </thead>
            <tbody>
              {games.map((g) => (
                <tr data-row={g.id} data-status={g.status} data-search={searchIndex(g.title, g.slug, g.category, g.tags)}>
                  <td class="admin-table__cover">
                    {g.cover ? (
                      <img src={g.cover} alt="" width="84" height="47" loading="lazy" />
                    ) : (
                      <span class="admin-table__noimg" aria-hidden="true">no cover</span>
                    )}
                  </td>
                  <td class="admin-table__game">
                    <strong>{g.title}</strong>
                    <br />
                    <a class="small muted" href={`/games/${g.slug}/`} target="_blank" rel="noopener noreferrer">
                      /games/{g.slug}/
                    </a>
                  </td>
                  <td><span class="chip chip--sm">{g.category}</span></td>
                  <td>
                    <span class:list={['badge', g.status === 'published' ? 'badge--live' : 'badge--draft']}>
                      <span class="badge__dot" aria-hidden="true"></span>{g.status}
                    </span>
                  </td>
                  <td>{g.featured ? <span class="admin-star" aria-label="Featured">★</span> : <span class="muted">—</span>}</td>
                  <td class="small muted">{g.updatedAt.slice(0, 10)}</td>
                  <td class="admin-actions">
                    <button class="btn btn--ghost btn--xs" type="button" data-edit={g.id}>Edit</button>
                    <button class="btn btn--secondary btn--xs" type="button" data-toggle={g.id}>
                      {g.status === 'published' ? 'Unpublish' : 'Publish'}
                    </button>
                    <button class="btn btn--ghost btn--xs admin-actions__danger" type="button" data-delete={g.id}>
                      Delete
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="empty-state admin-no-match" data-admin-no-match hidden>
          No games match your search or filter.
        </p>
      </>
    )}
  </div>

  <form class="admin-form panel" data-game-form>
    <h2 data-form-title>Add a game</h2>
    <p class="small muted">Slug is generated from the title. Saving publishes instantly — no rebuild.</p>
    <input type="hidden" name="id" value="" />

    <div class="form-section">
      <h3 class="form-section__title">Details</h3>
      <label class="field">
        <span>Title</span>
        <input class="input" type="text" name="title" maxlength="80" required />
      </label>

      <label class="field">
        <span>Description</span>
        <textarea class="input" name="description" rows="3" maxlength="600" required></textarea>
      </label>

      <div class="field-row">
        <label class="field">
          <span>Category</span>
          <input class="input" type="text" name="category" list="category-list" maxlength="40" placeholder="parking" />
          <datalist id="category-list">
            {CATEGORIES.map((c) => <option value={c} />)}
          </datalist>
        </label>
        <label class="field">
          <span>Tags <span class="muted small">(comma separated)</span></span>
          <input class="input" type="text" name="tags" maxlength="300" placeholder="top-down, keyboard" />
        </label>
      </div>

      <label class="field">
        <span>Controls <span class="muted small">(how players drive it)</span></span>
        <input class="input" type="text" name="controls" maxlength="400" placeholder="Arrow keys or WASD to drive" />
      </label>

      <label class="field">
        <span>Specs <span class="muted small">(one per line: Label | Value)</span></span>
        <textarea class="input" name="specs" rows="3" placeholder={'Devices | Desktop + mobile\nEngine | HTML5'}></textarea>
      </label>
    </div>

    <div class="form-section">
      <h3 class="form-section__title">Cover image</h3>
      <label class="file-drop" data-drop-zone>
        <input
          class="file-drop__input"
          type="file"
          name="coverFile"
          accept="image/jpeg,image/png,image/webp,image/gif,image/avif"
        />
        <span class="file-drop__text">
          <strong>Choose a cover</strong> or drop an image here
          <span class="muted small">JPG / PNG / WebP / GIF / AVIF · max 8 MB</span>
        </span>
      </label>
      <input type="hidden" name="coverUrl" value="" />
      <div class="admin-form__preview" data-cover-preview-wrap hidden>
        <img class="admin-form__cover" data-cover-preview alt="Cover preview" />
        <button class="btn btn--ghost btn--xs" type="button" data-cover-clear>Remove cover</button>
      </div>
      <p class="form-error" data-upload-error hidden></p>
    </div>

    <div class="form-section">
      <h3 class="form-section__title">Game embed</h3>
      <label class="field">
        <span>URL or iframe code</span>
        <textarea
          class="input"
          name="embedUrl"
          rows="3"
          placeholder={'https://example.com/game.html   — or paste an <iframe …> snippet'}></textarea>
      </label>
      <p class="small muted">
        The game opens in a frame on its own page here — players never leave this site. Only embed
        games you have the right to embed; hosts must allow framing.
      </p>
    </div>

    <div class="form-section">
      <h3 class="form-section__title">Publishing</h3>
      <div class="field-row">
        <label class="field">
          <span>Status</span>
          <select class="input" name="status">
            <option value="published">Published (live now)</option>
            <option value="draft">Draft (hidden)</option>
          </select>
        </label>
        <label class="field field--check">
          <input type="checkbox" name="featured" />
          <span>Featured (shown first on the homepage)</span>
        </label>
      </div>
    </div>

    <div class="btn-row">
      <button class="btn btn--primary" type="submit" data-save-label>Publish game</button>
      <button class="btn btn--ghost" type="button" data-reset>Clear form</button>
    </div>
    <p class="form-error" data-form-error hidden></p>
  </form>
</div>

<script type="application/json" id="games-data" is:inline set:html={JSON.stringify(games).replace(/</g, '\\u003c')} />

<script>
  interface GameSpec {
    label: string;
    value: string;
  }
  interface GameRecord {
    id: string;
    slug: string;
    title: string;
    description: string;
    category: string;
    tags: string[];
    controls: string;
    specs: GameSpec[];
    cover: string | null;
    embedUrl: string;
    status: 'published' | 'draft';
    featured: boolean;
    updatedAt: string;
  }

  const dataEl = document.getElementById('games-data');
  const games: GameRecord[] = dataEl ? (JSON.parse(dataEl.textContent ?? '[]') as GameRecord[]) : [];
  const byId = (id: string) => games.find((g) => g.id === id);

  const showError = (selector: string, message: string | null) => {
    const el = document.querySelector<HTMLElement>(selector);
    if (!el) return;
    el.hidden = !message;
    el.textContent = message ?? '';
  };

  const toast = (message: string, kind: 'ok' | 'err' = 'ok') => {
    const host = document.querySelector('[data-toasts]');
    if (!host) return;
    const item = document.createElement('div');
    item.className = `toast toast--${kind}`;
    item.textContent = message;
    host.append(item);
    window.setTimeout(() => item.remove(), 4200);
  };

  /* ---- game form + live table ---- */
  const form = document.querySelector<HTMLFormElement>('[data-game-form]');
  if (form) {
    const el = <T extends HTMLElement>(name: string) =>
      form.elements.namedItem(name) as unknown as T;
    const titleInput = el<HTMLInputElement>('title');
    const descInput = el<HTMLTextAreaElement>('description');
    const catInput = el<HTMLInputElement>('category');
    const tagsInput = el<HTMLInputElement>('tags');
    const controlsInput = el<HTMLInputElement>('controls');
    const specsInput = el<HTMLTextAreaElement>('specs');
    const coverFile = el<HTMLInputElement>('coverFile');
    const coverUrl = el<HTMLInputElement>('coverUrl');
    const embedInput = el<HTMLTextAreaElement>('embedUrl');
    const statusSelect = el<HTMLSelectElement>('status');
    const featuredInput = el<HTMLInputElement>('featured');
    const idInput = el<HTMLInputElement>('id');
    const coverPreview = document.querySelector<HTMLImageElement>('[data-cover-preview]');
    const coverPreviewWrap = document.querySelector<HTMLElement>('[data-cover-preview-wrap]');
    const formTitle = document.querySelector('[data-form-title]');
    const saveBtn = document.querySelector<HTMLButtonElement>('[data-save-label]');
    const tbody = document.querySelector<HTMLTableSectionElement>('.admin-table tbody');
    const countEl = document.querySelector('[data-admin-count]');
    const noMatch = document.querySelector<HTMLElement>('[data-admin-no-match]');
    const searchInput = document.querySelector<HTMLInputElement>('[data-admin-search]');
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-admin-filter]'));
    let statusFilter = 'all';

    const escapeHtml = (s: string) =>
      s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string);

    const refreshPreview = () => {
      if (!coverPreview || !coverPreviewWrap) return;
      const url = coverUrl.value;
      coverPreviewWrap.hidden = !url;
      coverPreview.src = url;
    };

    const setForm = (g?: GameRecord) => {
      idInput.value = g?.id ?? '';
      titleInput.value = g?.title ?? '';
      descInput.value = g?.description ?? '';
      catInput.value = g?.category ?? '';
      tagsInput.value = g?.tags.join(', ') ?? '';
      controlsInput.value = g?.controls ?? '';
      specsInput.value = g?.specs.map((s) => `${s.label} | ${s.value}`).join('\n') ?? '';
      coverUrl.value = g?.cover ?? '';
      coverFile.value = '';
      embedInput.value = g?.embedUrl ?? '';
      statusSelect.value = g?.status ?? 'published';
      featuredInput.checked = g?.featured ?? false;
      if (formTitle) formTitle.textContent = g ? `Edit “${g.title}”` : 'Add a game';
      if (saveBtn) saveBtn.textContent = g ? 'Save changes' : 'Publish game';
      showError('[data-form-error]', null);
      showError('[data-upload-error]', null);
      refreshPreview();
    };

    coverFile?.addEventListener('change', () => {
      const file = coverFile.files?.[0];
      if (file) {
        coverUrl.value = '';
        if (coverPreview) {
          coverPreview.src = URL.createObjectURL(file);
          if (coverPreviewWrap) coverPreviewWrap.hidden = false;
        }
      }
    });

    document.querySelector('[data-cover-clear]')?.addEventListener('click', () => {
      coverFile.value = '';
      coverUrl.value = '';
      refreshPreview();
    });

    /* drag & drop cover */
    const dropZone = document.querySelector<HTMLElement>('[data-drop-zone]');
    dropZone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('file-drop--over');
    });
    dropZone?.addEventListener('dragleave', () => dropZone.classList.remove('file-drop--over'));
    dropZone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('file-drop--over');
      const files = e.dataTransfer?.files;
      if (files && files.length > 0 && coverFile) {
        const dt = new DataTransfer();
        dt.items.add(files[0]);
        coverFile.files = dt.files;
        coverFile.dispatchEvent(new Event('change'));
      }
    });

    const uploadCover = async (): Promise<string | null> => {
      const file = coverFile.files?.[0];
      if (!file) return coverUrl.value || null;
      const fd = new FormData();
      fd.append('file', file);
      const res = await fetch('/api/admin/upload/', { method: 'POST', body: fd });
      const data = (await res.json().catch(() => ({}))) as { url?: string; error?: string };
      if (!res.ok || !data.url) throw new Error(data.error ?? 'Cover upload failed.');
      return data.url;
    };

    const sendGame = async (body: Record<string, unknown>, id?: string) => {
      const res = await fetch(id ? `/api/admin/games/${id}/` : '/api/admin/games/', {
        method: id ? 'PATCH' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data = (await res.json().catch(() => ({}))) as { game?: GameRecord; error?: string };
      if (!res.ok) throw new Error(data.error ?? 'Saving the game failed.');
      return data.game;
    };

    /* Keep the array in the same order listGames() sorts: featured first,
       then most recently updated. */
    const sortGames = () =>
      games.sort((a, b) => {
        if (a.featured !== b.featured) return a.featured ? -1 : 1;
        return b.updatedAt.localeCompare(a.updatedAt);
      });

    const rowHTML = (g: GameRecord) => {
      const search = `${g.title} ${g.slug} ${g.category} ${g.tags.join(' ')}`.toLowerCase();
      const cover = g.cover
        ? `<img src="${escapeHtml(g.cover)}" alt="" width="84" height="47" loading="lazy" />`
        : `<span class="admin-table__noimg" aria-hidden="true">no cover</span>`;
      const badgeClass = g.status === 'published' ? 'badge badge--live' : 'badge badge--draft';
      const featured = g.featured
        ? `<span class="admin-star" aria-label="Featured">★</span>`
        : `<span class="muted">—</span>`;
      return `<tr data-row="${escapeHtml(g.id)}" data-status="${g.status}" data-search="${escapeHtml(search)}">
        <td class="admin-table__cover">${cover}</td>
        <td class="admin-table__game">
          <strong>${escapeHtml(g.title)}</strong><br />
          <a class="small muted" href="/games/${encodeURIComponent(g.slug)}/" target="_blank" rel="noopener noreferrer">/games/${escapeHtml(g.slug)}/</a>
        </td>
        <td><span class="chip chip--sm">${escapeHtml(g.category)}</span></td>
        <td><span class="${badgeClass}"><span class="badge__dot" aria-hidden="true"></span>${g.status}</span></td>
        <td>${featured}</td>
        <td class="small muted">${g.updatedAt.slice(0, 10)}</td>
        <td class="admin-actions">
          <button class="btn btn--ghost btn--xs" type="button" data-edit="${escapeHtml(g.id)}">Edit</button>
          <button class="btn btn--secondary btn--xs" type="button" data-toggle="${escapeHtml(g.id)}">${g.status === 'published' ? 'Unpublish' : 'Publish'}</button>
          <button class="btn btn--ghost btn--xs admin-actions__danger" type="button" data-delete="${escapeHtml(g.id)}">Delete</button>
        </td>
      </tr>`;
    };

    const applyFilters = () => {
      if (!tbody) return;
      const q = (searchInput?.value ?? '').trim().toLowerCase();
      let visible = 0;
      for (const row of Array.from(tbody.rows)) {
        const ds = row.dataset;
        const okQuery = !q || (ds.search ?? '').includes(q);
        const okStatus = statusFilter === 'all' || ds.status === statusFilter;
        const show = okQuery && okStatus;
        row.hidden = !show;
        if (show) visible += 1;
      }
      if (countEl) {
        countEl.textContent =
          visible === games.length
            ? `${games.length} game${games.length === 1 ? '' : 's'}`
            : `${visible} of ${games.length} games shown`;
      }
      if (noMatch) noMatch.hidden = !(visible === 0 && games.length > 0);
    };

    const updateStats = () => {
      const set = (key: string, value: number) => {
        const node = document.querySelector<HTMLElement>(`[data-stat="${key}"]`);
        if (node) node.textContent = String(value);
      };
      const published = games.filter((g) => g.status === 'published').length;
      set('total', games.length);
      set('published', published);
      set('drafts', games.length - published);
      set('featured', games.filter((g) => g.featured).length);
    };

    const renderRows = () => {
      if (!tbody) return false;
      tbody.innerHTML = games.map(rowHTML).join('');
      applyFilters();
      return true;
    };

    const refreshAll = () => {
      sortGames();
      updateStats();
      if (!renderRows() || games.length === 0) location.reload(); // table was server-rendered empty, or is now
    };

    searchInput?.addEventListener('input', applyFilters);
    for (const btn of filterButtons) {
      btn.addEventListener('click', () => {
        statusFilter = btn.dataset.adminFilter ?? 'all';
        for (const other of filterButtons) {
          const active = other === btn;
          other.classList.toggle('chip--active', active);
          other.setAttribute('aria-pressed', String(active));
        }
        applyFilters();
      });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      showError('[data-form-error]', null);
      const editing = idInput.value || undefined;
      if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving…';
      }
      try {
        const cover = await uploadCover();
        const body = {
          title: titleInput.value,
          description: descInput.value,
          category: catInput.value,
          tags: tagsInput.value,
          controls: controlsInput.value,
          specs: specsInput.value,
          cover,
          embedUrl: embedInput.value,
          status: statusSelect.value,
          featured: featuredInput.checked,
        };
        const saved = await sendGame(body, editing);
        if (saved) {
          const existing = byId(saved.id);
          if (existing) Object.assign(existing, saved);
          else games.push(saved);
          refreshAll();
          toast(
            saved.status === 'published'
              ? `“${saved.title}” is live on /games/`
              : `“${saved.title}” saved as a draft`,
          );
          setForm();
        } else {
          location.reload();
        }
      } catch (err) {
        showError('[data-form-error]', err instanceof Error ? err.message : 'Save failed.');
        toast(err instanceof Error ? err.message : 'Save failed.', 'err');
      } finally {
        if (saveBtn) {
          saveBtn.disabled = false;
          saveBtn.textContent = idInput.value ? 'Save changes' : 'Publish game';
        }
      }
    });

    document.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('button');
      if (!btn) return;

      if (btn.dataset.newGame !== undefined) {
        setForm();
        form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        titleInput.focus();
        return;
      }
      if (btn.dataset.edit) {
        setForm(byId(btn.dataset.edit));
        form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        titleInput.focus();
        return;
      }
      if (btn.dataset.reset !== undefined) {
        setForm();
        return;
      }
      if (btn.dataset.toggle) {
        const g = byId(btn.dataset.toggle);
        if (!g) return;
        const next = g.status === 'published' ? 'draft' : 'published';
        try {
          const saved = await sendGame({ ...g, status: next }, g.id);
          if (saved) Object.assign(g, saved);
          else g.status = next;
          refreshAll();
          toast(next === 'published' ? `“${g.title}” is live on /games/` : `“${g.title}” moved to drafts`);
        } catch (err) {
          showError('[data-form-error]', err instanceof Error ? err.message : 'Update failed.');
          toast(err instanceof Error ? err.message : 'Update failed.', 'err');
        }
        return;
      }
      if (btn.dataset.delete) {
        const g = byId(btn.dataset.delete);
        if (!g) return;
        if (!confirm(`Delete “${g.title}”? It disappears from the site immediately.`)) return;
        const res = await fetch(`/api/admin/games/${g.id}/`, { method: 'DELETE' });
        if (res.ok) {
          const i = games.indexOf(g);
          if (i >= 0) games.splice(i, 1);
          refreshAll();
          toast(`“${g.title}” deleted`);
        } else {
          showError('[data-form-error]', 'Delete failed.');
          toast('Delete failed.', 'err');
        }
      }
    });
  }
</script>
