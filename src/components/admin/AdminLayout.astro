---
/**
 * AdminLayout — the shared shell for every operator page (dashboard,
 * analytics, SEO). Renders the topbar + a persistent sidebar nav around a
 * page body, and owns the login/logout client script so it isn't repeated.
 *
 * The `.admin-shell` class is what the e2e suite keys off to know the
 * dashboard rendered after sign-in, so it must stay on the root element.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  /** Page <h1> shown in the topbar. */
  title: string;
  /** Short crumb label, e.g. "Games dashboard". */
  crumb?: string;
  /** Active nav key — matches the sidebar link's data-nav value. */
  active: 'overview' | 'analytics' | 'seo';
}

const { title, crumb, active } = Astro.props;
const pagePath = Astro.url.pathname;

const NAV = [
  { key: 'overview', href: '/admin/', label: 'Overview', icon: '◧', hint: 'Library & publishing' },
  { key: 'analytics', href: '/admin/analytics/', label: 'Analytics', icon: '▲', hint: 'Traffic & plays' },
  { key: 'seo', href: '/admin/seo/', label: 'Search & SEO', icon: '⌕', hint: 'Sitemap & indexing' },
] as const;
---

<BaseLayout
  seo={{ title: `${title} — Parking Fury Guide`, description: 'Site administration.', path: pagePath, noindex: true }}
  breadcrumbs={false}
  header={false}
  footer={false}
>
  <section class="admin-shell container--wide">
    <header class="admin-topbar">
      <div class="admin-topbar__id">
        <span class="brand__mark" aria-hidden="true">
          <img src="/images/logo-mark.png" alt="" width="32" height="32" />
        </span>
        <div>
          <p class="admin-topbar__crumb">Parking&nbsp;<strong>Fury</strong> Guide · operator console{crumb ? ` · ${crumb}` : ''}</p>
          <h1 class="admin-topbar__title">{title}</h1>
        </div>
      </div>
      <div class="admin-topbar__actions">
        <a class="btn btn--ghost btn--sm" href="/games/" target="_blank" rel="noopener noreferrer">
          View site<span class="sr-only">(opens in a new tab)</span>
        </a>
        <button class="btn btn--secondary btn--sm" type="button" data-logout>Sign out</button>
      </div>
    </header>

    <div class="admin-layout">
      <nav class="admin-nav panel" aria-label="Admin sections">
        <ul class="admin-nav__list">
          {NAV.map((item) => (
            <li>
              <a
                class="admin-nav__link"
                href={item.href}
                data-nav={item.key}
                aria-current={item.key === active ? 'page' : undefined}
              >
                <span class="admin-nav__icon" aria-hidden="true">{item.icon}</span>
                <span class="admin-nav__text">
                  <strong>{item.label}</strong>
                  <span class="admin-nav__hint">{item.hint}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <div class="admin-nav__footer">
          <p class="small muted">Session expires after 7 days. Every save publishes instantly — no rebuild.</p>
        </div>
      </nav>

      <div class="admin-main">
        <slot />
      </div>
    </div>

    <div class="admin-toasts" data-toasts aria-live="polite"></div>
  </section>
</BaseLayout>

<script>
  /* Shell behaviour: sign-out. (Sign-in lives with the login card itself,
     since the shell is not rendered on the unauthenticated view.) */
  document.querySelector('[data-logout]')?.addEventListener('click', async () => {
    await fetch('/api/admin/logout/', { method: 'POST' });
    location.href = '/admin/';
  });
</script>
