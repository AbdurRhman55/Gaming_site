---
/**
 * AdminLogin — the sign-in card, shared by every admin page so an
 * unauthenticated visit to /admin/analytics/ or /admin/seo/ is handled the
 * same way. Renders its own BaseLayout (always noindex) so the page works
 * standalone without a shell.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  seo={{ title: 'Admin sign in — Parking Fury Guide', description: 'Site administration.', path: '/admin/', noindex: true }}
  breadcrumbs={false}
  header={false}
  footer={false}
>
  <section class="admin-login container">
  <form class="admin-login__card panel" data-login-form>
    <img
      class="admin-login__logo"
      src="/images/logo-hero.jpg"
      alt="Parking Fury — golden supercar on a parking bay"
      width="960"
      height="536"
    />
    <div class="admin-login__brand">
      <span class="brand__mark" aria-hidden="true">
        <img src="/images/logo-mark.png" alt="" width="32" height="32" />
      </span>
      <span>Parking&nbsp;<strong>Fury</strong>&nbsp;Guide</span>
    </div>
    <h1>Admin sign in</h1>
    <p class="muted small">Sign in to publish, analyse traffic and manage search visibility.</p>
    <label class="field">
      <span>Username</span>
      <input class="input" type="text" name="user" autocomplete="username" required />
    </label>
    <label class="field">
      <span>Password</span>
      <input class="input" type="password" name="password" autocomplete="current-password" required />
    </label>
    <button class="btn btn--primary" type="submit">Sign in</button>
    <p class="form-error" data-login-error hidden></p>
    <p class="small muted admin-login__note">
      Operator console — sessions are signed cookies and expire after 7 days.
    </p>
  </form>
  </section>
</BaseLayout>

<script>
  /* Sign-in for every admin page — the card is the only view rendered when
     unauthenticated, so the handler must live here (the shell is absent). */
  const loginForm = document.querySelector<HTMLFormElement>('[data-login-form]');
  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(loginForm);
    const res = await fetch('/api/admin/login/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ user: fd.get('user'), password: fd.get('password') }),
    });
    if (res.ok) location.reload();
    else {
      const err = document.querySelector<HTMLElement>('[data-login-error]');
      if (err) {
        err.hidden = false;
        err.textContent = 'Wrong username or password.';
      }
    }
  });
</script>
