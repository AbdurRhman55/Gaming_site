---
/**
 * GamingGallery — a visually stunning showcase grid of game cover art.
 * Displays up to 8 unique cover images from all games in a 4-column
 * responsive grid with hover effects and play overlays.
 */
import { VERSIONS, RELATED_GAMES } from '../data/games';

const allCovers = [
  ...VERSIONS.filter((v) => v.cover).map((v) => ({ name: v.name, cover: v.cover!, slug: v.slug, url: `/games/${v.slug}/` })),
  ...RELATED_GAMES.filter((g) => g.cover).map((g) => ({ name: g.name, cover: g.cover!, slug: g.slug, url: g.url })),
];
// Deduplicate by cover URL and take first 8
const seen = new Set<string>();
const gallery = allCovers.filter((g) => { if (seen.has(g.cover)) return false; seen.add(g.cover); return true; }).slice(0, 8);
---

<section class="section gallery-section" aria-labelledby="gallery-heading">
  <div class="section-head">
    <span class="eyebrow">Gallery</span>
    <h2 id="gallery-heading">Gaming Screenshots &amp; Artwork</h2>
    <p>
      Explore cover art and screenshots from every game in the library.
      Each image links straight to the in-site player — click any card to start playing instantly.
    </p>
  </div>
  <div class="gallery-grid">
    {gallery.map((g) => (
      <a class="gallery-card" href={g.url}>
        <img src={g.cover} alt={g.name} width="640" height="360" loading="lazy" decoding="async" />
        <span class="gallery-card__play" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z" /></svg>
        </span>
        <span class="gallery-card__overlay">
          <span class="gallery-card__name">{g.name}</span>
          <span class="gallery-card__cta">Play now <span aria-hidden="true">→</span></span>
        </span>
      </a>
    ))}
  </div>
</section>
