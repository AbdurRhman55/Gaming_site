---
import { FOOTER_NAV, SITE } from '../data/site';

interface Props {
  disclaimer: string;
  year: number;
}

const { disclaimer, year } = Astro.props;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer__brand">
        <a class="brand" href="/">
          <span class="brand__mark" aria-hidden="true">
            <img src="/images/logo-mark.png" alt="" width="32" height="32" loading="lazy" />
          </span>
          <span class="brand__text">Parking&nbsp;<strong>Fury</strong>&nbsp;Guide</span>
        </a>
        <img
          class="footer__logo"
          src="/images/logo-hero.jpg"
          alt="Parking Fury — golden supercar on a parking bay"
          width="960"
          height="536"
          loading="lazy"
        />
        <p>{SITE.tagline}</p>
      </div>

      {FOOTER_NAV.map((col) => (
        <div class="footer__col">
          <h2>{col.title}</h2>
          <ul>
            {col.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="footer__legal">
      <p>{disclaimer}</p>
      <p>Game facts on this site were checked against the official hosting platforms in October 2026. No game files are hosted or re-uploaded here; outbound links go to the platforms that license each game.</p>
      <p>© {year} {SITE.name}. Original site content and mini-game © {year} {SITE.name}.</p>
    </div>
  </div>
</footer>
