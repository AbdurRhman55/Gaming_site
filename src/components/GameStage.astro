---
/**
 * GameStage — the playable region.
 *
 * Behaviour depends on the GAME_EMBED_URL build-time variable:
 *  - unset (default): transparent "official game not embedded" panel plus an
 *    original, self-authored parking mini-game that runs entirely on-device.
 *  - set: an iframe loaded on demand from the licensed host, with loading,
 *    timeout and error states, and a retry path back to the official link.
 *
 * Nothing here fakes a play button: every button does exactly what its label says.
 */
interface Props {
  /** Display title of the official game, e.g. "Parking Fury". */
  title: string;
  /** Verified official host page URL. */
  officialUrl: string;
  /** Name of the official host, e.g. "Coolmath Games". */
  officialHost: string;
  /** Show the original mini-game option (default true). */
  miniGame?: boolean;
  /** Short line shown under the stage. */
  credit?: string;
  /**
   * Page-level embed override. `undefined` falls back to the global
   * GAME_EMBED_URL env var; an empty string disables embedding for this page.
   */
  embedUrl?: string;
}

const {
  title,
  officialUrl,
  officialHost,
  miniGame = true,
  credit = '',
  embedUrl: embedUrlProp,
} = Astro.props;

const embedUrl = (
  embedUrlProp ??
  (process.env.GAME_EMBED_URL ||
    (import.meta.env as Record<string, string | undefined>).GAME_EMBED_URL ||
    '')
).trim();
const embedTitle = (process.env.GAME_EMBED_TITLE || import.meta.env.GAME_EMBED_TITLE || title).trim();
/* Licensed embeds must be https in production; plain http is allowed only for
   localhost/127.0.0.1 integration testing (browsers block http frames on https
   pages anyway, and operators configure this env var themselves). */
const hasEmbed = /^https:\/\//i.test(embedUrl) || /^http:\/\/(localhost|127\.0\.0\.1)/i.test(embedUrl);
---

<section class="stage" id="game" aria-labelledby="stage-heading">
  <div class="stage__bar">
    <h2 class="stage__title" id="stage-heading">
      {title}
      {hasEmbed ? (
        <span class="pill pill--off" data-stage-pill>
          <span class="pill__dot" aria-hidden="true"></span>Official embed: idle
        </span>
      ) : (
        <span class="pill pill--off" data-stage-pill>
          <span class="pill__dot" aria-hidden="true"></span>Official embed: not connected
        </span>
      )}
    </h2>
    <span class="small muted" data-stage-clock></span>
  </div>

  <div class="stage__body" data-stage-body data-state="idle">
    <!-- ===== state: idle ===== -->
    <div class="stage__panel" data-panel="idle">
      {hasEmbed ? (
        <>
          <h3>Load {embedTitle}</h3>
          <p>
            The game streams from <strong>{officialHost}</strong>’s licensed player.
            Loading it applies that host’s own terms and privacy policy to the frame.
          </p>
          <div class="btn-row">
            <button class="btn btn--primary" type="button" data-action="load-embed">Load the game</button>
            {miniGame && (
              <button class="btn btn--secondary" type="button" data-action="start-mini">Play our mini-game</button>
            )}
          </div>
        </>
      ) : (
        <>
          <h3>{title} isn’t embedded on this site — yet</h3>
          <p>
            We don’t hold an embedding licence from {title}’s rights holder, and its licensed
            hosts block framing from other sites, so rather than pirate a copy we send you
            to the real thing. You can play {title} on <strong>{officialHost}</strong>, or try
            the original mini-game we built for this page — it runs instantly, with no ads and
            nothing to install.
          </p>
          <div class="btn-row">
            <a class="btn btn--primary" href="/games/">
              Browse All Playable Games
            </a>
            {miniGame && (
              <button class="btn btn--secondary" type="button" data-action="start-mini">Play the mini-game here</button>
            )}
          </div>
        </>
      )}
    </div>

    <!-- ===== state: loading ===== -->
    <div class="stage__panel" data-panel="loading" hidden>
      <div class="spinner" aria-hidden="true"></div>
      <h3 data-loading-title>{hasEmbed ? 'Loading the game…' : 'Loading the mini-game…'}</h3>
      <p data-loading-note>If this takes more than a few seconds, refresh or try our high-performance mini-game.</p>
    </div>

    <!-- ===== state: error ===== -->
    <div class="stage__panel" data-panel="error" hidden>
      <h3>The game didn’t load</h3>
      <p data-error-note>
        The frame timed out or is blocked on your network.
      </p>
      <div class="btn-row">
        <button class="btn btn--secondary" type="button" data-action="retry">Try again</button>
        <a class="btn btn--ghost" href="/games/">
          Browse All Playable Games
        </a>
      </div>
    </div>

    <!-- ===== state: iframe (only when configured) ===== -->
    {hasEmbed && (
      <iframe
        class="stage__frame"
        data-embed
        hidden
        title={embedTitle}
        src="about:blank"
        data-src={embedUrl}
        referrerpolicy="strict-origin-when-cross-origin"
        allow="fullscreen; gamepad"
        sandbox="allow-scripts allow-same-origin allow-forms allow-pointer-lock"
      ></iframe>
    )}

    <!-- ===== state: original mini-game ===== -->
    {miniGame && (
      <div class="minigame" data-minigame hidden>
        <div class="hud" role="status" aria-live="polite">
          <div class="hud__group">
            <span class="hud__brand" aria-hidden="true">
              <img src="/images/logo-mark.png" alt="" width="20" height="20" />
            </span>
            <span>Lot <strong data-hud-level>1/3</strong></span>
            <span>Time <strong data-hud-time>0.0s</strong></span>
            <span>Scrapes <strong data-hud-scrapes>0</strong></span>
          </div>
          <div class="hud__group">
            <span data-hud-status>Ready</span>
          </div>
        </div>
        <div class="minigame__canvas-wrap" data-canvas-wrap>
          <canvas data-canvas width="640" height="400">
            An original top-down parking mini-game: steer a car into the
            highlighted bay without touching walls or parked cars.
          </canvas>
          <div class="stage__panel" data-panel="gameover" hidden>
            <h3 data-over-title>Level complete</h3>
            <p data-over-text></p>
            <div class="btn-row">
              <button class="btn btn--primary" type="button" data-action="next">Next lot</button>
              <button class="btn btn--secondary" type="button" data-action="restart">Restart</button>
            </div>
          </div>
        </div>
        <div class="touch-pad" aria-label="Touch driving controls">
          <div class="touch-pad__cluster">
            <button class="touch-btn" type="button" data-key="left" aria-label="Steer left">◀<small>Left</small></button>
            <button class="touch-btn" type="button" data-key="right" aria-label="Steer right">▶<small>Right</small></button>
          </div>
          <div class="touch-pad__cluster">
            <button class="touch-btn" type="button" data-key="down" aria-label="Reverse or brake">▼<small>Reverse</small></button>
            <button class="touch-btn" type="button" data-key="up" aria-label="Accelerate">▲<small>Gas</small></button>
          </div>
        </div>
      </div>
    )}
  </div>

  <p class="stage__note">
    <span aria-hidden="true">ℹ</span>
    <span>
      {credit ||
        `Game facts checked against ${officialHost} (October 2026). The mini-game is our own original work — Parking Fury is not affiliated with this site.`}
      <a href="/about/#embeds">How embeds work here</a>
    </span>
  </p>
</section>

<script>
  interface StageAPI {
    destroy?: () => void;
  }

  const body = document.querySelector<HTMLElement>('[data-stage-body]');
  if (body) {
    const panels = {
      idle: body.querySelector<HTMLElement>('[data-panel="idle"]'),
      loading: body.querySelector<HTMLElement>('[data-panel="loading"]'),
      error: body.querySelector<HTMLElement>('[data-panel="error"]'),
      gameover: body.querySelector<HTMLElement>('[data-panel="gameover"]'),
    };
    const iframe = body.querySelector<HTMLIFrameElement>('[data-embed]');
    const mini = body.querySelector<HTMLElement>('[data-minigame]');
    const pill = document.querySelector<HTMLElement>('[data-stage-pill]');
    const errorNote = body.querySelector<HTMLElement>('[data-error-note]');
    let mode: 'idle' | 'embed' | 'mini' = 'idle';
    let timer: ReturnType<typeof setTimeout> | undefined;
    let api: StageAPI | null = null;
    let miniPromise: Promise<StageAPI> | null = null;

    const setState = (state: string) => {
      body!.dataset.state = state;
      for (const [key, el] of Object.entries(panels)) {
        if (el) el.hidden = key !== state;
      }
      if (iframe) iframe.hidden = state !== 'embed-ready';
      if (mini) mini.hidden = state !== 'mini';
    };

    const loadMini = async (): Promise<StageAPI> => {
      if (!miniPromise) {
        miniPromise = import('../scripts/parking-game')
          .then((mod) => mod.initParkingGame(body!.querySelector('[data-minigame]') as HTMLElement))
          .catch((err) => {
            console.error('Mini-game failed to load', err);
            if (errorNote) {
              errorNote.textContent =
                'The mini-game code failed to load. Check your connection and try again, or play the official game on ' +
                (pill ? 'its licensed host' : 'the licensed host') + ' via the link in the error panel.';
            }
            setState('error');
            miniPromise = null;
            throw err;
          });
      }
      return miniPromise;
    };

    const startMini = async () => {
      mode = 'mini';
      setState('loading');
      try {
        api = await loadMini();
        if (pill) {
          pill.className = 'pill pill--live';
          pill.innerHTML = '<span class="pill__dot" aria-hidden="true"></span>Original mini-game running';
        }
        setState('mini');
      } catch {
        /* setState('error') already handled */
      }
    };

    const loadEmbed = () => {
      if (!iframe) return;
      mode = 'embed';
      setState('loading');
      const src = iframe.dataset.src;
      if (iframe.getAttribute('src') !== src) iframe.setAttribute('src', src || '');
      iframe.addEventListener(
        'load',
        () => {
          clearTimeout(timer);
          if (pill) {
            pill.className = 'pill pill--live';
            pill.innerHTML = '<span class="pill__dot" aria-hidden="true"></span>Official game loaded';
          }
          setState('embed-ready');
        },
        { once: true },
      );
      // Cross-origin frames that are blocked or slow rarely report an error,
      // so fall back to a timeout with a direct link.
      clearTimeout(timer);
      timer = setTimeout(() => {
        if (body!.dataset.state === 'loading') {
          setState('error');
          if (pill) {
            pill.className = 'pill pill--off';
            pill.innerHTML = '<span class="pill__dot" aria-hidden="true"></span>Embed timed out';
          }
        }
      }, 15000);
    };

    body.addEventListener('click', (e) => {
      const action = (e.target as HTMLElement).closest<HTMLElement>('[data-action]')?.dataset.action;
      if (!action) return;
      if (action === 'start-mini') void startMini();
      if (action === 'load-embed') loadEmbed();
      if (action === 'retry') {
        if (mode === 'mini') void startMini();
        else if (mode === 'embed') loadEmbed();
        else setState('idle');
      }
      if (action === 'restart' || action === 'next') {
        const detail = { action };
        document.dispatchEvent(new CustomEvent('minigame:command', { detail }));
      }
    });

    // Pause gameplay while the stage is off-screen (keeps INP/light work low).
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          document.dispatchEvent(
            new CustomEvent('minigame:visible', { detail: entry.isIntersecting }),
          );
        }
      },
      { threshold: 0.25 },
    );
    io.observe(body);
    window.addEventListener('pagehide', () => api?.destroy?.(), { once: true });
  }
</script>
