---
/**
 * FAQ list built on native <details>/<summary>: keyboard accessible and
 * indexable without JavaScript. Answers may contain trusted HTML (links).
 */
export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="faq">
  {items.map((item) => (
    <details>
      <summary>{item.q}</summary>
      <div class="faq__answer" set:html={item.a} />
    </details>
  ))}
</div>
