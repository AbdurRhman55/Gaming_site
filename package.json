{
  "name": "parking-fury-guide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dynamic Parking Fury gaming portal: admin-published games that play inside the site, plus verified guides for the Parking Fury series.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node dist/server/entry.mjs",
    "test": "node scripts/check-site.mjs",
    "test:site": "npm run build && node scripts/check-site.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:external": "node scripts/check-external.mjs",
    "test:all": "npm run build && node scripts/check-site.mjs && node scripts/e2e.mjs",
    "optimize:uploads": "node scripts/optimize-uploads.mjs",
    "start": "node dist/server/entry.mjs"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "astro": "^7.4.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.0"
  }
}
