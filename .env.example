# Copy to .env and adjust. The production server reads these at RUNTIME
# (process env wins; a .env file in the working directory is the fallback).
# Never commit the real .env.

# Origin used for canonical URLs, sitemap, robots.txt and Open Graph.
# REQUIRED in production — the dev fallback publishes localhost URLs.
SITE_URL=

# Optional licensed third-party embed for the version pages (pf2/pf3/pf3d).
# Must be https:// in production. Leave unset: the pages show the honest
# "not connected" state with links to the official hosts.
GAME_EMBED_URL=
GAME_EMBED_TITLE=

# Address shown on /contact/. Unset = the page states honestly that no
# address is configured (it never invents one).
CONTACT_EMAIL=

# ---- Admin dashboard (/admin) ----
# Logins are REJECTED while ADMIN_PASSWORD is unset (safe by default).
ADMIN_USER=admin
ADMIN_PASSWORD=
# HMAC key for the pf_admin session cookie; falls back to the password.
ADMIN_SESSION_SECRET=
