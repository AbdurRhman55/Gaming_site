# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is git-ignored —
# it must never be committed or pushed.
# Hostinger: create the database + user in hPanel (Databases → MySQL), then
# copy the credentials here. Leave DB_DSN unset for SQLite local dev.
# ----------------------------------------------------------------------------

# Public origin of the live site, no trailing slash (used for canonical URLs,
# Open Graph and the sitemap).
SITE_URL=https://your-domain.com

# MySQL (Hostinger) — uncomment and fill in on the server.
#DB_DSN=mysql:host=localhost;dbname=u123456789_parking;charset=utf8mb4
#DB_USER=u123456789_parking
#DB_PASS=CHANGE_ME_STRONG_PASSWORD

# Local development alternative (default when DB_DSN is unset): a SQLite file
# is created automatically under data/ — no database setup needed.

# Admin login for /admin/ — REQUIRED, all logins fail while unset.
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# HMAC key for the session cookie (defaults to ADMIN_PASSWORD when unset).
# Generate one: php -r "echo bin2hex(random_bytes(32));"
ADMIN_SESSION_SECRET=
